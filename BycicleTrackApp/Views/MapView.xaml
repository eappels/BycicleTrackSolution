<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             x:Class="BycicleTrackApp.Views.MapView"
             Padding="0"
             ios:Page.UseSafeArea="False"
             Shell.NavBarIsVisible="False"
             Title="MapView">
    <AbsoluteLayout IgnoreSafeArea="True">
        <maps:Map x:Name="MyMap"
                  AbsoluteLayout.LayoutBounds="0,0,1,1"
                  AbsoluteLayout.LayoutFlags="All"
                  Margin="0" />

        <Border AbsoluteLayout.LayoutBounds="1,0,AutoSize,AutoSize"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                Margin="0,44,16,0"
                BackgroundColor="#CC1F1F1F"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>
            <Button Text="History"
                     Clicked="OnHistoryClicked"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontAttributes="Bold"
                    Padding="18,10" />
        </Border>

        <Border AbsoluteLayout.LayoutBounds="0.5,1,140,80"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                Margin="0,0,0,32"
           BackgroundColor="#CC1F1F1F"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28" />
            </Border.StrokeShape>
            <Button Text="{Binding StartStopButtonText}"
                    Command="{Binding StartStopCommand}"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    WidthRequest="140"
                    HeightRequest="80" />
        </Border>
    </AbsoluteLayout>
</ContentPage>