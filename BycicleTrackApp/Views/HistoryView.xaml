<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
             x:Class="BycicleTrackApp.Views.HistoryView"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*"
          Padding="20,52,20,20">
        <Grid RowDefinitions="Auto,Auto"
              RowSpacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="History"
                       FontSize="28"
                       FontAttributes="Bold"
                       VerticalTextAlignment="Center" />
                <Button Grid.Column="1"
                        Text="Close"
                        Clicked="OnCloseClicked"
                        BackgroundColor="Transparent"
                        TextColor="Gray" />
            </Grid>

            <Grid Grid.Row="1"
                  ColumnDefinitions="Auto,*,Auto">
                <Button Text="Newer"
                        Command="{Binding ShowNewerRideCommand}"
                        IsEnabled="{Binding CanShowNewerRide}"
                        BackgroundColor="Transparent"
                        TextColor="#0F766E" />
                <Label Grid.Column="1"
                       Text="{Binding CurrentRideTitle}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       FontAttributes="Bold" />
                <Button Grid.Column="2"
                        Text="Older"
                        Command="{Binding ShowOlderRideCommand}"
                        IsEnabled="{Binding CanShowOlderRide}"
                        BackgroundColor="Transparent"
                        TextColor="#0F766E" />
            </Grid>
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,20,0,0">
            <maps:Map x:Name="HistoryMap" />

            <VerticalStackLayout x:Name="EmptyState"
                                 Padding="0,24"
                                 Spacing="8"
                                 VerticalOptions="Center">
                <Label Text="No rides yet"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />
                <Label Text="Completed rides will appear here."
                       HorizontalTextAlignment="Center"
                       TextColor="Gray" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
